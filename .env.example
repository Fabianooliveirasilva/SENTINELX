# SentinelX environment configuration.
#
# Generate a ready-to-use .env with random secrets:
#     make env            (or: python3 scripts/generate_env.py)
#
# Never commit .env. Values below are placeholders and are rejected in production.
# Passwords must be URL-safe (letters, digits, '-', '_') because they are
# embedded in connection URLs.

# --- Runtime --------------------------------------------------------------
SENTINELX_ENVIRONMENT=development        # development | test | production
SENTINELX_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
SENTINELX_SECRET_KEY=change-me-generate-a-random-64-char-value-with-make-env

# Comma-separated origins allowed to call the API cross-origin. Leave empty when
# the frontend is served same-origin (the default for docker compose and Vite).
SENTINELX_CORS_ALLOWED_ORIGINS=

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=sentinelx
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=change-me

# --- Redis ----------------------------------------------------------------
REDIS_PASSWORD=change-me

# --- Local (non-Docker) development only ----------------------------------
# Used when running the API/worker directly on the host with `make dev-api`.
# Point these at reachable PostgreSQL/Redis instances.
# SENTINELX_DATABASE_URL=postgresql+asyncpg://sentinelx:change-me@127.0.0.1:5432/sentinelx
# SENTINELX_REDIS_URL=redis://:change-me@127.0.0.1:6379/0
