# SentinelX environment configuration.
#
# Generate a ready-to-use .env with random secrets:
#     make env            (or: python3 scripts/generate_env.py)
#
# Never commit .env. Values below are placeholders and are rejected in production.
# Passwords must be URL-safe (letters, digits, '-', '_') because they are
# embedded in connection URLs.

# --- Runtime --------------------------------------------------------------
SENTINELX_ENVIRONMENT=development        # development | test | production
SENTINELX_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
SENTINELX_SECRET_KEY=change-me-generate-a-random-64-char-value-with-make-env

# Comma-separated origins allowed to call the API cross-origin. Leave empty when
# the frontend is served same-origin (the default for docker compose and Vite).
SENTINELX_CORS_ALLOWED_ORIGINS=

# --- Authentication -------------------------------------------------------
# Public URL of the web app, used to build password-reset links.
SENTINELX_FRONTEND_BASE_URL=http://localhost:8080
# console = print emails (incl. reset links) to the API's stderr; development only.
# smtp = deliver through an SMTP relay (STARTTLS or implicit TLS, verified certs).
# disabled = drop emails. Production requires smtp or disabled.
SENTINELX_EMAIL_BACKEND=console
SENTINELX_EMAIL_FROM=SentinelX <no-reply@sentinelx.example.com>
SENTINELX_SMTP_HOST=
SENTINELX_SMTP_PORT=587
SENTINELX_SMTP_SECURITY=starttls
SENTINELX_SMTP_USERNAME=
SENTINELX_SMTP_PASSWORD=
# Alert webhooks may target private addresses only inside these CIDRs
# (comma-separated, e.g. an internal chat server). Public addresses are allowed.
SENTINELX_WEBHOOK_ALLOWED_NETWORKS=
# Self-registration creates Viewer accounts with no project access. Off by default.
SENTINELX_ALLOW_SELF_REGISTRATION=false
# Optional tuning (defaults shown):
# SENTINELX_ACCESS_TOKEN_TTL_SECONDS=600
# SENTINELX_REFRESH_TOKEN_TTL_SECONDS=604800
# SENTINELX_LOGIN_MAX_FAILURES=5
# SENTINELX_LOGIN_LOCKOUT_SECONDS=900
# SENTINELX_RATE_LIMIT_LOGIN_PER_MINUTE=10

# --- Scope enforcement ----------------------------------------------------
# Intentionally vulnerable LAB networks/domains that may be registered and tested
# (comma-separated). Loopback, link-local and cloud metadata always stay blocked.
# Leave empty unless you run a dedicated lab.
SENTINELX_SCOPE_LAB_NETWORKS=
SENTINELX_SCOPE_LAB_DOMAINS=

# --- Scans (Phase 4) ---------------------------------------------------------
# SENTINELX_SCAN_TIMEOUT_SECONDS=240
# SENTINELX_SCAN_QUEUE_TIMEOUT_SECONDS=1800
# SENTINELX_MAX_CONCURRENT_SCANS_PER_PROJECT=3
# SENTINELX_MAX_DAILY_SCANS_PER_PROJECT=50
# Scanner sandbox: set to false to disable third-party passive sources (crt.sh).
# SENTINELX_PASSIVE_SOURCES_ENABLED=true
# SENTINELX_ZAP_SCAN_TIMEOUT_SECONDS=900

# --- Threat intelligence (Phase 6) -------------------------------------------
# Optional NVD API key (https://nvd.nist.gov/developers/request-an-api-key):
# raises the rate limit from 5 to 50 requests per 30 seconds.
# SENTINELX_NVD_API_KEY=
# SENTINELX_INTEL_ENABLED=true
# SENTINELX_INTEL_PRODUCT_TTL_HOURS=24

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=sentinelx
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=change-me

# --- Redis ----------------------------------------------------------------
REDIS_PASSWORD=change-me

# --- OWASP ZAP (Phase 5) --------------------------------------------------
# Shared only between the ZAP daemon and the ZAP scanner worker.
ZAP_API_KEY=change-me

# --- Local (non-Docker) development only ----------------------------------
# Used when running the API/worker directly on the host with `make dev-api`.
# Point these at reachable PostgreSQL/Redis instances.
# SENTINELX_DATABASE_URL=postgresql+asyncpg://sentinelx:change-me@127.0.0.1:5432/sentinelx
# SENTINELX_REDIS_URL=redis://:change-me@127.0.0.1:6379/0
